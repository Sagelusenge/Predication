NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/papaleki
DATABASE_SSL=false
COOKIE_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
INVITATION_TTL_DAYS=7
STORAGE_ROOT=./storage
MAX_AUDIO_MB=500
MAX_IMAGE_MB=12
WORKER_POLL_INTERVAL_MS=5000
WORKER_API_KEY=replace-with-a-long-random-worker-key
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PapaLeki <noreply@example.com>
TRUST_PROXY=false
LOG_LEVEL=info
